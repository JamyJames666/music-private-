DISCORD_TOKEN=
DATA_DIR=./data
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

############
# Optional #
############

# CACHE_LIMIT=2GB

# ENABLE_SPONSORBLOCK=true
# SPONSORBLOCK_TIMEOUT=5    # Delay (in mn) before retrying when SponsorBlock server are unreachable.
# YT_DLP_PATH=yt-dlp
# YT_DLP_AUTO_UPDATE=true

# See the README for details on the below variables
# BOT_STATUS=
# BOT_ACTIVITY_TYPE=
# BOT_ACTIVITY_URL=
# BOT_ACTIVITY=

# ── Spotify Connect (optional) ────────────────────────────────────────────────
# Turns the bot into a Spotify Connect speaker so you can drive it straight from
# the Spotify app. Requires Spotify Premium.
SPOTIFY_CONNECT_ENABLED=false
SPOTIFY_CONNECT_DEVICE_NAME=Muse
# 96 | 160 | 320
SPOTIFY_CONNECT_BITRATE=320
# Set true for a one-off login flow when mDNS discovery isn't available — which
# is always the case on a cloud host, and on Docker Desktop for Windows/macOS.
# The auth URL is printed to the container logs. Leave false only when the bot
# runs on a Linux machine on the same LAN as your phone, with network_mode: host.
SPOTIFY_CONNECT_ENABLE_OAUTH=false
# Port librespot's OAuth redirect server listens on. The sign-in redirect goes
# to 127.0.0.1 relative to the bot, so on a remote host reach it with:
#   ssh -L 5588:localhost:5588 you@your-server
SPOTIFY_CONNECT_OAUTH_PORT=5588
